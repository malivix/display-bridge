#!/usr/bin/env python3
"""Check exact index blobs; never copy private untracked files to the scanner."""

import argparse
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[1]
BLOCKED_PARTS = {
    ".local-only",
    "evidence",
    "__pycache__",
    ".objects",
    ".env",
    ".claude",
    ".codex",
    ".harness",
    ".ssh",
}
BLOCKED_SUFFIXES = {
    ".zip",
    ".dmg",
    ".log",
    ".jsonl",
    ".pyc",
    ".pem",
    ".key",
    ".p12",
    ".pfx",
    ".o",
}
BLOCKED_NAMES = {
    "CLAUDE.local.md",
    "AGENTS.local.md",
    "config.json",
    "baseline.json",
    "manifest.json",
    "health.json",
    "recovery.json",
    "control.json",
    "audio-refresh.json",
    "transitions.json",
    "menu-health.json",
    "rotation-active.json",
    "scaling-preview.json",
    "preview-status.json",
    "preview-request.json",
}
PATTERNS = {
    "concrete home path": re.compile(r"/(?:Users|home)/[A-Za-z0-9_.-]+/"),
    "device UUID": re.compile(
        r"\b[0-9A-Fa-f]{8}(?:-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}\b"
    ),
    "private key": re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"),
}


def git(*args):
    return subprocess.check_output(["git", "-C", str(ROOT), *args])


def check_blob(name, mode, data):
    path = PurePosixPath(name)
    errors = []
    if (
        path.is_absolute()
        or ".." in path.parts
        or set(path.parts) & BLOCKED_PARTS
        or path.suffix in BLOCKED_SUFFIXES
        or path.name.startswith(".env")
        or path.name in BLOCKED_NAMES
        or name in ("display-layout", "vendor/m1ddc/m1ddc")
    ):
        errors.append("private/generated artifact")
    if mode not in ("100644", "100755"):
        errors.append("symlink, submodule, or unsupported file mode")
    if len(data) > 1_000_000 or b"\0" in data:
        errors.append("binary or oversized file")
    try:
        source = data.decode("utf-8")
    except UnicodeDecodeError:
        return errors + ["non-text file"]
    for label, pattern in PATTERNS.items():
        if pattern.search(source):
            errors.append(label)
    return errors


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--history", action="store_true")
    args = parser.parse_args()
    if not shutil.which("gitleaks"):
        raise SystemExit("Gitleaks is required; install it before publication checks.")
    entries = git("ls-files", "--stage", "-z").split(b"\0")
    if not any(entries):
        raise SystemExit("No tracked files: stage the reviewed public files first.")
    failures = []
    with tempfile.TemporaryDirectory(prefix="display-bridge-public-") as directory:
        for entry in filter(None, entries):
            meta, raw_name = entry.split(b"\t", 1)
            mode, oid, stage = meta.decode().split()
            name = os.fsdecode(raw_name)
            data = git("cat-file", "blob", oid)
            errors = check_blob(name, mode, data)
            if stage != "0":
                errors.append("unmerged index")
            if errors:
                failures.append(f"{name}: {', '.join(errors)}")
                continue
            target = Path(directory) / name
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(data)
        if failures:
            raise SystemExit("\n".join(failures))
        subprocess.run(
            ["gitleaks", "dir", directory, "--redact", "--no-banner"], check=True
        )
    if args.history:
        subprocess.run(
            ["gitleaks", "git", str(ROOT), "--redact", "--no-banner"], check=True
        )
        seen = set()
        for revision in git("rev-list", "--all").decode().splitlines():
            for entry in filter(
                None, git("ls-tree", "-r", "-z", revision).split(b"\0")
            ):
                meta, name = entry.split(b"\t", 1)
                mode, kind, oid = meta.decode().split()
                identity = (mode, oid, name)
                if identity in seen:
                    continue
                seen.add(identity)
                errors = (
                    check_blob(os.fsdecode(name), mode, git("cat-file", "blob", oid))
                    if kind == "blob"
                    else ["submodule or unsupported historical entry"]
                )
                if errors:
                    raise SystemExit(
                        "Historical entry rejected: "
                        + os.fsdecode(name)
                        + ": "
                        + ", ".join(errors)
                    )
        emails = git("log", "--all", "--format=%ae%n%ce").decode().splitlines()
        if any(not email.endswith("@users.noreply.github.com") for email in emails):
            raise SystemExit("Commit author/committer email must use GitHub noreply.")
    print(
        "PASS staged privacy and secret checks"
        + ("; history checked" if args.history else "")
    )


if __name__ == "__main__":
    main()
